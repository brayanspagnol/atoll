#!/usr/bin/env bash
# Atoll profiles: one settings file each, in ~/.config/atoll/profiles.
#   profiles list                  -> [{"id", "name", "photo"}]
#   profiles create ID FROM NAME   -> copies profile FROM as ID
#   profiles delete ID             -> removes the profile
#   profiles photos                -> paths of the saved pictures, newest first
#   profiles photo IMAGE           -> saves a copy of IMAGE, prints its path
#   profiles wallpapers            -> paths of the saved wallpapers, newest first
#   profiles wallpaper IMAGE       -> saves a copy of IMAGE, prints its path
#   profiles forget photo|wallpaper PATH -> deletes a saved image; profiles using it go without one
set -euo pipefail
dir="$HOME/.config/atoll/profiles"
faces="$HOME/.local/share/atoll/faces"
walls="$HOME/.local/share/atoll/backgrounds"

valid() { [[ "$1" =~ ^[a-z0-9-]{1,40}$ ]] || { echo "invalid profile id: $1" >&2; exit 2; }; }

list_images() {
    [[ -d "$1" ]] || return 0
    find "$1" -maxdepth 1 -type f -printf '%T@ %p\n' | sort -rn | cut -d' ' -f2-
}

save_image() {
    [[ -f "$2" ]] || { echo "not a file: $2" >&2; exit 1; }
    mkdir -p "$1"
    # Named by content: the same image is kept once, and a new image gets a new path, which reloads the picture.
    local target
    target="$1/$(sha256sum "$2" | cut -c1-32)"
    [[ -e "$target" ]] || cp "$2" "$target"
    touch "$target"
    echo "$target"
}

forget_image() {
    local kind="$1" folder="$2" path="$3" file part
    # Only files of the gallery itself: this deletes what it is given.
    [[ "$(dirname -- "$path")" == "$folder" && -f "$path" ]] || { echo "not in the gallery: $path" >&2; exit 1; }
    rm -f -- "$path"
    shopt -s nullglob
    for file in "$dir"/*.json; do
        jq -e --arg key "$kind" --arg path "$path" '.[$key] == $path or (.wallpapers // {} | any(. == $path))' "$file" >/dev/null || continue
        part="$(mktemp "$dir/.XXXXXX")"
        jq --arg key "$kind" --arg path "$path" '(if .[$key] == $path then .[$key] = "" else . end)
            | (if has("wallpapers") then .wallpapers |= with_entries(select(.value != $path)) else . end)' "$file" >"$part"
        mv "$part" "$file"
    done
}

case "${1:-}" in
    list)
        shopt -s nullglob
        for file in "$dir"/*.json; do
            id="$(basename "$file" .json)"
            jq -c --arg id "$id" '{id: $id, name: (.name // env.USER // $id), photo: (.photo // "")}' "$file"
        done | jq -s 'sort_by(.name | ascii_downcase)'
        ;;
    create)
        valid "$2"
        valid "$3"
        [[ ! -e "$dir/$2.json" ]] || { echo "profile exists: $2" >&2; exit 1; }
        part="$(mktemp "$dir/.XXXXXX")"
        jq --arg name "$4" '.name = $name | .photo = ""' "$dir/$3.json" >"$part"
        mv "$part" "$dir/$2.json"
        ;;
    delete)
        valid "$2"
        rm -f "$dir/$2.json"
        ;;
    photos) list_images "$faces" ;;
    photo) save_image "$faces" "$2" ;;
    wallpapers) list_images "$walls" ;;
    wallpaper) save_image "$walls" "$2" ;;
    forget)
        case "${2:-}" in
            photo) forget_image photo "$faces" "$3" ;;
            wallpaper) forget_image wallpaper "$walls" "$3" ;;
            *) echo "usage: profiles forget photo|wallpaper PATH" >&2; exit 2 ;;
        esac
        ;;
    *)
        echo "usage: profiles list|create|delete|photos|photo|wallpapers|wallpaper|forget" >&2
        exit 2
        ;;
esac
