#!/usr/bin/env bash
# Cycles every keyboard to its next configured layout.
set -euo pipefail
hyprctl devices -j | jq -r '.keyboards[].name' | while read -r keyboard; do
    hyprctl switchxkblayout "$keyboard" next >/dev/null
done
layout="$(hyprctl devices -j | jq -r '(.keyboards | map(select(.main)) | first // {}).active_keymap // "?"')"
notify-send -a Keyboard -u low -t 1500 "Keyboard layout" "$layout" || true
