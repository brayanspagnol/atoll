#!/usr/bin/env bash
# Keeps the shell running: a crash restarts the UI, never the compositor or the apps.
log="${XDG_STATE_HOME:-$HOME/.local/state}/atoll"
mkdir -p "$log"
# Bounded: past 1 MB, only the last 2000 lines stay.
if [[ -f "$log/shell.log" ]] && (($(wc -c <"$log/shell.log") > 1048576)); then
    tail -n 2000 "$log/shell.log" >"$log/shell.log.tmp" && mv -f "$log/shell.log.tmp" "$log/shell.log"
fi
fails=0
while :; do
    started=$SECONDS
    qs -c atoll >>"$log/shell.log" 2>&1
    code=$?
    [[ $code -eq 0 ]] && exit 0
    # Compositor gone (logout, shutdown): restarting would only fail without a display.
    { [[ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]] && hyprctl version >/dev/null 2>&1; } || exit 0
    ((SECONDS - started > 60)) && fails=0
    fails=$((fails + 1))
    echo "$(date -Is) qs exited with $code (failure $fails)" >>"$log/shell.log"
    if ((fails >= 5)); then
        notify-send -u critical Atoll "The shell crashed 5 times. See $log/shell.log"
        exit 1
    fi
    sleep 1
done
